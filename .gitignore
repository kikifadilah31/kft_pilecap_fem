# Output run (timestamped, tidak pernah di-commit)
output/

# Config bertimestamp yang ditulis formulir `pilecap-ui`. Isinya milik satu run tertentu
# dan sudah terekam di run_manifest.json beserta sha256-nya, jadi tidak perlu ikut
# ter-version-control.
ui_configs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Artefak mesh hasil eksperimen di root
/*.msh

# PRD_pilecap_fem.md -- sengaja TIDAK ter-version-control sejak repo ini dijadikan publik
# (2026-08-10). PRD Bagian 1.3 poin 4 menuntut spesifikasi ter-version-control agar
# ditelusuri versi mana yang dipakai tiap rilis -- tetapi PRD memuat detail proyek yang
# tidak untuk publik, dan repo publik tidak punya visibilitas per-berkas. Trade-off ini
# keputusan sadar pemilik proyek: PRD tetap ada lokal (lihat juga ref/), traceability-nya
# ditanggung di luar git selama repo ini publik.
PRD_pilecap_fem.md

# Panduan mandiri (`pilecap-manual`). Sumber `.typ` dan ilustrasinya DI-commit supaya
# dokumen yang diedarkan dapat ditinjau sebagai diff teks dan dikompilasi ulang siapa pun.
# PDF-nya tidak: ia ~0,8 MB per rilis, dihasilkan ulang dengan satu perintah, dan
# diedarkan sebagai release asset di samping wheel.
docs/manual/*.pdf
